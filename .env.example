IBM_QUANTUM_TOKEN=your_ibm_token_here
IBM_CHANNEL=ibm_quantum_platform
IONQ_API_KEY=your_ionq_key_here

# Optional — shared Turso database for live, laptop-independent device
# history (get_alerts / drift detection). Falls back to the local db
# automatically when unset. Same database quantum-hardware-mcp uses.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here
